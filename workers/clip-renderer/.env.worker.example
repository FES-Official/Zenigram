# Used only by the persistent FFmpeg worker container.
# Do not add AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
AWS_REGION=replace-with-your-aws-region
AWS_BUCKET_NAME=replace-with-existing-private-bucket
DYNAMODB_TABLE_NAME=replace-with-existing-dynamodb-table
CLIP_RENDER_QUEUE_URL=replace-with-sqs-queue-url
FFMPEG_PRESET=veryfast
FFMPEG_CRF=22
