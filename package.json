    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.11.6",
    "@ffmpeg/util": "^0.12.2",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
