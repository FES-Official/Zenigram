# HTTPS origin of the existing Next.js API (no trailing slash).
# For local device testing, use your computer's LAN IP rather than localhost.
EXPO_PUBLIC_API_URL=https://your-zenigram-api-domain

# Android native map tiles require a Google Maps SDK for Android key.
# Restrict it to com.fesofficial.zenigram and your Android signing SHA-1.
# Provide it to EAS/CI as a build-time secret; do not commit an actual key.
ANDROID_GOOGLE_MAPS_API_KEY=
